{
  "name": "steipete-astro",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:check": "astro check && pnpm run test && pnpm run build && pnpm run test:build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "astro sync",
    "lint": "oxlint --deny-warnings --import-plugin src astro.config.mjs public/toggle-theme.js",
    "lint:fix": "oxlint --fix --deny-warnings --import-plugin src astro.config.mjs public/toggle-theme.js",
    "format": "git ls-files '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.json' | xargs oxfmt --write",
    "format:check": "git ls-files '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.json' | xargs oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint",
    "check:fix": "pnpm run format && pnpm run lint:fix",
    "prepare": "husky",
    "test": "node --test tests/*.test.mjs",
    "test:build": "node --test tests/build/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@ibm/plex-mono": "^2.5.0",
    "@pagefind/default-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.3.2",
    "astro-embed": "^0.14.0",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "oxfmt --write"
    ],
    "*.{js,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
