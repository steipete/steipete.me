{
  "name": "steipete-astro",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:check": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "scripts/deploy.sh",
    "add-source-metadata": "node scripts/add-source-metadata.mjs",
    "remove-tags": "node scripts/remove-tags-from-posts.mjs",
    "sync": "astro sync",
    "lint": "oxlint --deny-warnings --import-plugin --react-plugin src astro.config.mjs",
    "lint:fix": "oxlint --fix --deny-warnings --import-plugin --react-plugin src astro.config.mjs",
    "format": "git ls-files '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.json' | xargs oxfmt --write",
    "format:check": "git ls-files '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.json' | xargs oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint",
    "check:fix": "pnpm run format && pnpm run lint:fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@pagefind/default-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.3.2",
    "astro-embed": "^0.13.1",
    "dayjs": "^1.11.23",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lodash.kebabcase": "^4.1.1",
    "pagefind": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.29.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "commitizen": "^4.3.2",
    "cosmiconfig": "^9.0.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.82.0",
    "postcss": "^8.5.28"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "oxfmt --write"
    ],
    "*.{js,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
