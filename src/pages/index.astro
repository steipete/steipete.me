---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hr from "@/components/Hr.astro";
import Socials from "@/components/Socials.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SOCIALS, SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
---

<Layout description={SITE.desc}>
  <StructuredData type="WebSite" data={{}} />
  <StructuredData type="Person" data={{}} />
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-6 pb-4">
      <div class="mx-auto flex max-w-3xl flex-col items-start gap-4 px-4 sm:flex-row">
        <a href="/about" class="group mx-auto block sm:mx-0">
          <img
            src="/avatar.jpg"
            alt={SITE.title}
            class="h-40 w-40 rounded-full object-cover flex-shrink-0 transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
          />
        </a>
        <div class="flex-1 text-center sm:text-left">
          <h1 class="my-2 text-3xl font-bold sm:my-4 sm:text-4xl">
            {SITE.title}
          </h1>
          <p class="max-w-2xl text-base leading-7 text-muted-foreground">
            Hi, I'm Nik, an SRE/DevOps engineer. This is my CV site and blog, where I share my experience, projects, and thoughts.
          </p>
        </div>
        {
          SOCIALS.filter((social) => social.active).length > 0 && (
            <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <Hr />

    <section class="mx-auto max-w-3xl px-4 py-10">
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="rounded-lg border border-border p-5">
          <h2 class="text-xl font-semibold">About</h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            Use this section for a short professional introduction, your specialization, and the type of roles or clients you are looking for.
          </p>
        </div>
        <div class="rounded-lg border border-border p-5">
          <h2 class="text-xl font-semibold">Experience</h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            Add your work history, key achievements, and the technologies you want to emphasize in your CV.
          </p>
        </div>
        <div class="rounded-lg border border-border p-5">
          <h2 class="text-xl font-semibold">Projects</h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            Showcase selected projects, products, case studies, or portfolio links that support your profile.
          </p>
        </div>
        <div class="rounded-lg border border-border p-5">
          <h2 class="text-xl font-semibold">Contacts</h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            Replace the placeholder social links in the config with your GitHub, LinkedIn, email, and any other relevant channels.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
