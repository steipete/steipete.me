---
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import { postsByYear, postsByMonth } from "@/utils/groupPosts";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props;

const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
---

{
  postsByYear(posts)
    .map(([year, yearGroup]) => (
      <div class="mb-8">
        <h2 class="text-2xl font-bold mb-6 border-b border-accent pb-2">
          {year}
          <sup class="text-sm ml-1">{yearGroup.length}</sup>
        </h2>
        {postsByMonth(yearGroup)
          .map(([month, monthGroup]) => (
            <div class="mt-8">
              <h3 class="text-xl font-bold mb-4">
                {months[month - 1]}
                <sup class="text-sm ml-1">{monthGroup.length}</sup>
              </h3>
              <ul>
                {monthGroup
                  .sort(
                    (a, b) =>
                      Math.floor(
                        b.data.pubDatetime.getTime() / 1000,
                      ) -
                      Math.floor(
                        a.data.pubDatetime.getTime() / 1000,
                      ),
                  )
                  .map((data) => (
                    <Card {...data} />
                  ))}
              </ul>
            </div>
          ))}
      </div>
    ))
}
