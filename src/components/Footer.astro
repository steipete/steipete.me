---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { profileContent } from "@/data/profile";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
const isRussian = Astro.url.pathname === "/ru" || Astro.url.pathname.startsWith("/ru/");
const content = profileContent[isRussian ? "ru" : "en"];
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials centered />
    <div class="my-2 flex max-w-xl flex-col items-center text-center sm:flex-row">
      <span class="text-sm text-muted-foreground">
        {content.footerTagline}
      </span>
    </div>
  </div>
</footer>
